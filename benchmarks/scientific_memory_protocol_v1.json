  "preregistered_candidates": [
    {
      "id": "evidence-constrained-associative-graph-v1",
      "frozen": true,
      "implementation": "wavemind.scientific_memory.EvidenceConstrainedAssociativeGraph",
      "energy": "sum_i x_i[-relevance_i-0.20*log(1+evidence_i)+0.50*counterevidence_i-1.00*utility_lcb_i+0.25*uncertainty_width_i]-0.10*sum_ij association_ij*x_i*x_j+0.50*sum_ij conflict_ij*x_i*x_j",
      "eligibility": "evidence_count > 0 and utility_lcb > 0 and counterevidence_count = 0",
      "selection": "exact minimum-energy subset under frozen token budget; abstain when best energy is non-negative"
    },
    {
      "id": "causal-utility-controller-v1",
      "frozen": true,
      "implementation": "wavemind.scientific_memory.CausalUtilityController",
      "estimator": "paired cluster bootstrap over independently verified treatment-control outcomes",
      "promotion": "95% CI lower bound > 0, at least three verified pairs, and false verified promotions = 0",
      "forgetting": "95% CI upper bound < 0 for marginal utility",
      "selection": "positive risk-adjusted lower bound under token, latency, applicability, validity, and safety constraints; otherwise abstain"
    },
    {
      "id": "hybrid-graph-causal-v1",
      "frozen": true,
      "optional": true,
      "implementation": "graph candidate restricted to memories promoted by causal-utility-controller-v1; no additional tuning parameters"
    }
