  "causal_hypothesis": "WaveMind Core appends confirmed updates without a versioned supersession transition. Old verified values remain eligible for recall, causing all observed bounded-development failures. An atomic supersede operation should preserve old provenance while making the predecessor ineligible for production recall.",
  "implementation_scope": {
    "public_api": "WaveMind.supersede(memory_id, replacement_text, namespace=..., metadata=...)",
    "storage": "Atomic predecessor status update plus replacement insert for SQLite and PostgreSQL stores.",
    "retrieval": "Existing confidence policy rejects the predecessor after its persisted memory_status becomes stale.",
    "provenance": "Replacement records supersedes_id and predecessor records superseded_by_id without hard deletion.",
    "recovery": "Restart and recovery-journal replay preserve the same active version and provenance chain.",
    "out_of_scope": [
      "conversation extraction",
      "reader or embedding changes",
      "ranking-weight tuning",
      "validation or final data",
      "STATE-Bench agent execution"
    ]
  },
