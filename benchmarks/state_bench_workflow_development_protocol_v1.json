  },
  "secondary_metrics": [
    "turns",
    "tool_calls",
    "tool_errors",
    "repeated_tool_calls",
    "context_tokens",
    "output_tokens",
    "latency_ms",
    "cost_proxy"
  ],
  "claim_boundary": "This lane measures deterministic final-state workflow behavior on frozen development rows with a local open-weight model. It is not an official STATE-Bench result, does not score UX, and does not establish held-out generalization. No-state tasks are safety diagnostics and do not substitute for task-content judging.",
  "preregistered_hypothesis": {
    "id": "verified-correction-guidance-v1",
    "statement": "On tasks whose training corpus contains independently admissible correction evidence, a minimal verified Experience Packet will reduce repeated policy/workflow errors without increasing forbidden writes. Raw TASK_DONE text is not verification evidence.",
    "affected_metrics": [
      "deterministic_state_pass_at_1",
      "deterministic_state_pass_power_5",
      "tool_errors",
      "repeated_tool_calls"
    ],
    "development_gate": {
      "memory_os_minus_strongest_baseline_pass_at_1": 0.01,
      "lower_95_ci_above": 0.0,
      "forbidden_write_regressions": 0,
      "namespace_leakage": 0
    }
  },
